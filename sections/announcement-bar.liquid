{%- comment -%} Announcement bar — top-of-page promo strip {%- endcomment -%}
{%- if section.settings.text != blank -%}
<div class="announcement-bar" id="announcement-{{ section.id }}" data-scheme="{{ section.settings.color_scheme }}" role="region" aria-label="Announcement">
  <div class="announcement-bar__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
        <span class="announcement-bar__text">{{ section.settings.text }}</span>
        {%- if section.settings.link_text != blank -%}
          <span class="announcement-bar__cta">{{ section.settings.link_text }} →</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <span class="announcement-bar__text">{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free Shipping All Orders"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text (optional)",
      "default": ""
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark (ink)" },
        { "value": "light", "label": "Light (paper)" },
        { "value": "accent", "label": "Accent (stone)" }
      ],
      "default": "dark"
    }
  ]
}
{% endschema %}
