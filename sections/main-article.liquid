<section class="section-padding page-width" style="max-width:var(--max-reading); margin:0 auto;">
  <div class="eyebrow" style="margin-bottom:16px">{{ article.published_at | date: '%B %d, %Y' | upcase }}</div>
  <h1 style="font-family:var(--font-display); font-size:clamp(36px,5vw,64px); text-transform:uppercase; font-weight:800; line-height:0.95; margin-bottom:32px;">{{ article.title }}</h1>

  {%- if article.image -%}
    <div style="margin-bottom:var(--space-8);">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="width:100%;">
    </div>
  {%- endif -%}

  <div class="about-text" style="max-width:100%;">
    {{ article.content }}
  </div>

  <div style="margin-top:var(--space-10); padding-top:var(--space-6); border-top:1px solid var(--border-1);">
    <a href="{{ blog.url }}" class="btn btn-ghost">← Back to {{ blog.title }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "settings": []
}
{% endschema %}
