{%- comment -%} AJAX cart drawer — rendered in layout, controlled by JS {%- endcomment -%}
<div class="cart-scrim" id="cart-scrim"></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-label="Shopping bag">
  <header class="drawer-head">
    <span class="drawer-title">{{ 'general.cart.title' | t }} · <span id="drawer-count">{{ cart.item_count }}</span></span>
    <button class="icon-btn" id="cart-close" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'x' %}</button>
  </header>

  <div class="drawer-body" id="drawer-body">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p style="margin-bottom:12px">{{ 'general.cart.empty' | t }}</p>
        <p style="font-size:12px; color:var(--fg-3)">{{ settings.free_shipping_text }}</p>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-line" data-line-key="{{ item.key }}">
          <div class="cart-thumb">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="cart-info">
            <div class="name">{{ item.product.title }}</div>
            <div class="meta">
              {%- for option in item.options_with_values -%}
                {{ option.value }}{% unless forloop.last %} · {% endunless %}
              {%- endfor -%}
            </div>
            <div class="cart-qty">
              <button class="qty-btn" data-qty-change="{{ item.key }}" data-delta="-1" aria-label="Decrease">{% render 'icon', name: 'minus', size: 12 %}</button>
              <span class="qty-num">{{ item.quantity }}</span>
              <button class="qty-btn" data-qty-change="{{ item.key }}" data-delta="1" aria-label="Increase">{% render 'icon', name: 'plus', size: 12 %}</button>
            </div>
          </div>
          <div class="cart-line-price">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <footer class="drawer-foot">
      <div class="cart-total">
        <span>{{ 'general.cart.subtotal' | t }}</span>
        <span id="drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size:11px; color:var(--fg-2); font-family:var(--font-mono); letter-spacing:.12em; text-transform:uppercase; margin:0;">
        {{ settings.free_shipping_text }}
      </p>
      <a href="/checkout" class="btn btn-primary btn-lg btn-block">{{ 'general.cart.checkout' | t }}</a>
    </footer>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
