{%- comment -%} Collection line tiles — 3-column grid linking to collections {%- endcomment -%}
<section class="section-padding page-width" id="line-tiles-{{ section.id }}">
  <div class="section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title" style="font-size:clamp(40px,5vw,64px)">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  </div>

  <div class="product-grid cols-3">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="product-card line-tile" {{ block.shopify_attributes }}>
        <div class="product-image-wrap">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" style="{% if block.settings.contain %}object-fit:contain; padding:24px; background:var(--stone-50);{% endif %}">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="line-tile-name">{{ block.settings.title }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the line"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Glow · Aura · Essentials"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Glow"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "contain",
          "label": "Contain image (vs. cover)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Glow" } },
        { "type": "tile", "settings": { "title": "Aura", "contain": true } },
        { "type": "tile", "settings": { "title": "Essentials", "contain": true } }
      ]
    }
  ]
}
{% endschema %}
