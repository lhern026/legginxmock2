<section class="section-padding page-width" style="text-align:center; max-width:480px; margin:0 auto;">
  <h1 class="section-title" style="margin-bottom:var(--space-5)">{{ shop.name }}</h1>
  <p style="color:var(--fg-2); margin-bottom:var(--space-8);">Opening soon.</p>
  {%- form 'storefront_password' -%}
    <div class="form-field">
      <input type="password" name="password" placeholder="Enter password">
    </div>
    <button type="submit" class="btn btn-primary btn-block">Enter</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": []
}
{% endschema %}
