{%- comment -%} Hero section — full-height with image, headline, and CTA {%- endcomment -%}
<section class="hero" id="hero-{{ section.id }}">
  {%- if section.settings.image -%}
    <img class="hero-img" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager">
  {%- endif -%}

  <div class="hero-content">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <div class="hero-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h1 class="hero-headline">{{ section.settings.headline }}</h1>
    </div>
    <div class="hero-meta">
      {%- if section.settings.meta_line_1 != blank -%}
        <span>{{ section.settings.meta_line_1 }}</span>
      {%- endif -%}
      {%- if section.settings.meta_line_2 != blank -%}
        <span>{{ section.settings.meta_line_2 }}</span>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn-secondary hero-cta">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "RIVAL · SS26"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline (use <br> for line breaks)",
      "default": "RUN.<br>LIFT.<br>REPEAT."
    },
    {
      "type": "text",
      "id": "meta_line_1",
      "label": "Meta line 1",
      "default": "FREE SHIPPING ALL ORDERS"
    },
    {
      "type": "text",
      "id": "meta_line_2",
      "label": "Meta line 2",
      "default": "$24 — $29"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Rival"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
